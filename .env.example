# Bu dosyanın adını .env yap ve doldur.

# TikTok kullanıcı adın (@ olmadan)
TIKTOK_KULLANICI=

# Bu Mac’te yerel sesleri seçmek için SES_MOTORU=yerel yaz.
SES_MOTORU=

# ElevenLabs (köylülerin sesleri). Boş bırakırsan Mac'in Türkçe sesi kullanılır.
ELEVENLABS_API_KEY=
# eleven_v3 duyguları ([angry], [whispers]...) en iyi verir. Hız istersen: eleven_flash_v2_5
ELEVEN_MODEL=eleven_v3
# İsimler (tek kelime) için hızlı model. Aynı ses kimliğiyle üretilir, ses değişmez.
ELEVEN_ISIM_MODEL=eleven_flash_v2_5

# Ses kimlikleri (ElevenLabs > Voices > sesin yanındaki ID). Boş bırakırsan hesabındaki seslerden otomatik seçer,
# hangisini seçtiğini başlarken terminale yazar.
ELEVEN_SES_ANLATICI=
ELEVEN_SES_MUHTAR=
ELEVEN_SES_BAKKAL=
ELEVEN_SES_EBE=
ELEVEN_SES_COBAN=
ELEVEN_SES_OGRETMEN=
ELEVEN_SES_DEMIRCI=

# İsteğe bağlı: izleyici sorularına GPT ile cevap. Boşsa senaryodaki hazır cevaplar kullanılır.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Süreler (saniye). Boş bırakırsan: lobi 35, sorgu 100, oylama 45
LOBI_SURE=
SORGU_SURE=
OYLAMA_SURE=

# Panel şifresi. Boşsa otomatik üretilir, başlarken terminalde yazar.
PANEL_ANAHTAR=
PORT=3000
