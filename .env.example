# Bu dosyayı .env adıyla kopyala.
# Canlı yayına bağlanmak için TikTok kullanıcı adını @ işareti olmadan yaz.
TIKTOK_KULLANICI=

# TikTok bağlantısı için kendi Euler Stream anahtarın (gerektiğinde).
EULER_API_KEY=

# Seçilen izleyici sorularına OpenAI ile cevap vermek istersen.
OPENAI_API_KEY=

# Karakterleri ElevenLabs ile seslendirmek istersen.
ELEVENLABS_API_KEY=

# Belirli bir ses seçmek için ElevenLabs Voice ID gir. Boş alanlar otomatik seçilir.
ELEVEN_SES_ANLATICI=
ELEVEN_SES_MUHTAR=
ELEVEN_SES_BAKKAL=
ELEVEN_SES_EBE=
ELEVEN_SES_COBAN=
ELEVEN_SES_OGRETMEN=
ELEVEN_SES_DEMIRCI=

# Kendi EMA/OpenVoice kurulumun varsa motoru yerel olarak ayarla.
SES_MOTORU=
YEREL_SES_PYTHON=
